# Frontend configuration - PUBLIC values only. Everything here ends up in
# config.js, which every browser downloads: never put a key, password,
# token or database address here. Backend secrets stay in the backend
# repository (Siru-ai-service) and its host (Render).
#
# Set in the Vercel project: Settings > Environment Variables.
# scripts/write-config.mjs reads it at build time and writes config.js.
# Must be https:// - the backend's public origin, no trailing path needed.
PUBLIC_API_BASE_URL=https://<your-render-service>.onrender.com

# Local development needs nothing here: with config.js's apiBaseUrl empty the
# app calls http://<this host>:8010, or the address saved under
# "Server settings" on the sign-in page.
